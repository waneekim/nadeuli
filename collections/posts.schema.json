{
  "$ref": "#/definitions/posts",
  "definitions": {
    "posts": {
      "type": "object",
      "properties": {
        "content_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "category": {
          "type": "string",
          "default": "etc"
        },
        "disclosure": {
          "type": "string"
        },
        "image_note": {
          "type": "string"
        },
        "as_of": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "publish": {
          "type": "boolean",
          "default": false
        },
        "publish_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "section": {
          "type": "string",
          "enum": [
            "event"
          ]
        },
        "event": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "start": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "integer",
                  "format": "unix-time"
                }
              ]
            },
            "end": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "integer",
                  "format": "unix-time"
                }
              ]
            },
            "hours": {
              "type": "string"
            },
            "venue": {
              "type": "string"
            },
            "address": {
              "type": "string"
            },
            "sido": {
              "type": "string",
              "enum": [
                "서울",
                "경기",
                "인천",
                "강원",
                "충북",
                "충남",
                "대전",
                "세종",
                "전북",
                "전남",
                "광주",
                "경북",
                "경남",
                "대구",
                "울산",
                "부산",
                "제주"
              ]
            },
            "sigungu": {
              "type": "string"
            },
            "lat": {
              "type": "number"
            },
            "lng": {
              "type": "number"
            },
            "fee": {
              "type": "string"
            },
            "offers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "price": {
                    "type": "number",
                    "minimum": 0
                  },
                  "priceCurrency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?:\\/\\/"
                  }
                },
                "required": [
                  "price",
                  "priceCurrency"
                ],
                "additionalProperties": false
              }
            },
            "performers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "Person",
                      "PerformingGroup"
                    ]
                  }
                },
                "required": [
                  "name",
                  "type"
                ],
                "additionalProperties": false
              }
            },
            "host": {
              "type": "string"
            },
            "official_url": {
              "type": "string"
            },
            "updated": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "integer",
                  "format": "unix-time"
                }
              ]
            },
            "state": {
              "type": "string",
              "enum": [
                "scheduled",
                "changed",
                "postponed",
                "cancelled"
              ],
              "default": "scheduled"
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time"
                      },
                      {
                        "type": "string",
                        "format": "date"
                      },
                      {
                        "type": "integer",
                        "format": "unix-time"
                      }
                    ]
                  },
                  "stage": {
                    "type": "string",
                    "enum": [
                      "research",
                      "d30",
                      "d7",
                      "extra"
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "date",
                  "stage"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "publisher": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "date": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time"
                      },
                      {
                        "type": "string",
                        "format": "date"
                      },
                      {
                        "type": "integer",
                        "format": "unix-time"
                      }
                    ]
                  }
                },
                "required": [
                  "title",
                  "url",
                  "publisher",
                  "type"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "source_file": {
              "type": "string"
            },
            "calendar": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            }
          },
          "required": [
            "name",
            "start",
            "end",
            "venue",
            "sido",
            "sigungu",
            "official_url",
            "updated"
          ],
          "additionalProperties": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "content_id",
        "title",
        "description",
        "as_of"
      ],
      "additionalProperties": true
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}